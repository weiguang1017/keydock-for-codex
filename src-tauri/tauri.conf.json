{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Keydock for Codex",
  "version": "1.0.1",
  "identifier": "dev.keydock.codex",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Keydock for Codex",
        "width": 1180,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "backgroundColor": "#090c12"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Check and switch Codex API keys.",
    "longDescription": "Keydock for Codex is a lightweight desktop manager for checking and switching Codex API keys stored in ~/.codex.",
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
